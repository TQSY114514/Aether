# Root-level .gitignore for the AetherAI workspace.
# Runtime data, secrets, and dev-only reference material must never be pushed.

# ── Secrets & runtime data ──
# Electron userData lives elsewhere (%APPDATA%/aetherai), but be paranoid:
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
background.img
background.img.meta
.env
.env.*
*.local
secrets.json

# ── Dev-only reference material (prefetched docs / cloned repos) ──
.tmp_fetch/
_ref/

# ── Claude Code local session artifacts ──
.claude/

# ── Build output & deps ──
**/dist/
**/dist-electron/
**/out/
**/node_modules/

# ── Electron builder cache ──
**/.electron-builder-cache/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / editor ──
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# electron-builder extracted temp files
app/dist-out/
app/.electron-builder-cache/

# Release artifacts staging (local downloads, not for the repo)
release-download/


# temp files
export.tmp
merge_history.*

# ── Dev-only reference material & fix scripts (not part of the app) ──
references/
scripts/
fix_test.js
.omo/
.trae/
