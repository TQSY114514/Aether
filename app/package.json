{
  "name": "aetherai",
  "version": "0.7.3",
  "description": "Aether headless agent — CLI, TUI, and Electron-free SDK. Pairs with the Aether Desktop GUI (separate installer) sharing the same agent runtime and SQLite store.",
  "author": "TQSY114514",
  "license": "MIT",
  "homepage": "https://github.com/TQSY114514/Aether#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/TQSY114514/Aether.git"
  },
  "bugs": {
    "url": "https://github.com/TQSY114514/Aether/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "tui",
    "sdk",
    "llm",
    "mcp",
    "electron-free",
    "aether",
    "aetherai",
    "agentic",
    "coding-agent",
    "openai",
    "anthropic",
    "deepseek"
  ],
  "main": "electron/main.js",
  "exports": {
    "./sdk": {
      "types": "./electron/sdk/index.d.ts",
      "default": "./electron/sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aether": "./cli.js"
  },
  "//": "files: NPM publish whitelist. Keeps the npm tarball small (excludes Electron, src/, dist/, release/, resources/, e2e/). The full app/ tree is published EXCEPT desktop-only paths — these are the blacklisted dirs that would otherwise pull in Electron + the renderer + the bundler config.",
  "files": [
    "cli.js",
    "tui/",
    "tui/package.json",
    "electron/cli/",
    "electron/sdk/",
    "electron/llm/",
    "electron/tools/",
    "electron/utils/",
    "electron/cron/",
    "electron/evolution/",
    "electron/mcp/",
    "electron/context/",
    "electron/plugins/",
    "electron/database.js",
    "electron/logger.js",
    "electron/featureFlags.js",
    "electron/worktreeManager.js",
    "electron/skills/",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "aether": "node cli.js",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "migrate-keys": "electron scripts/migrate-keys.cjs",
    "build": "node scripts/check-ipc.js && tsc --noEmit && vite build && node build-icons.js && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "smoke:boot": "node scripts/boot-smoke.js",
    "smoke:rpc": "node scripts/smoke-rpc.js",
    "check:ipc": "node scripts/check-ipc.js",
    "build:icon": "node build-icons.js",
    "build:win": "vite build && electron-builder --win --x64",
    "build:ci": "vite build && electron-builder --win --x64 --publish always",
    "start": "electron .",
    "test": "vitest run --fileParallelism=false --testTimeout=30000",
    "test:watch": "vitest",
    "test:e2e": "node e2e/launch.test.js",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('publishing from local is blocked; use npm run publish:npm in CI (see .github/workflows/npm-publish.yml)'); process.exit(1) }\" && npm run smoke:boot && npm run smoke:rpc && npm test",
    "publish:npm": "npm publish --provenance --access public",
    "postinstall": "node scripts/patch-brace-expansion.js & electron-rebuild -f -w better-sqlite3 || (echo [Aether] electron-rebuild unavailable ^(no Visual Studio build tools^) - using prebuilt better-sqlite3 & exit /b 0)"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "better-sqlite3": "^13.0.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.400.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "tar": "7.5.22",
    "brace-expansion": "2.1.4",
    "@electron/get": {
      "undici": "7.29.0"
    }
  }
}
