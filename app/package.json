{
  "name": "aetherai",
  "version": "0.7.0",
  "description": "Aether - Multi-provider AI aggregation client",
  "author": "TQSY114514",
  "main": "electron/main.js",
  "exports": {
    ".": "./electron/main.js",
    "./sdk": {
      "types": "./electron/sdk/index.d.ts",
      "default": "./electron/sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aether": "./cli.js"
  },
  "scripts": {
    "aether": "node cli.js",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "migrate-keys": "electron scripts/migrate-keys.cjs",
    "build": "node scripts/check-ipc.js && tsc --noEmit && vite build && node build-icons.js && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "smoke:boot": "node scripts/boot-smoke.js",
    "smoke:rpc": "node scripts/smoke-rpc.js",
    "check:ipc": "node scripts/check-ipc.js",
    "build:icon": "node build-icons.js",
    "build:win": "vite build && electron-builder --win --x64",
    "build:ci": "vite build && electron-builder --win nsis portable --x64 --publish always",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/launch.test.js",
    "postinstall": "node scripts/patch-brace-expansion.js & electron-rebuild -f -w better-sqlite3 || (echo [Aether] electron-rebuild unavailable ^(no Visual Studio build tools^) - using prebuilt better-sqlite3 & exit /b 0)"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "better-sqlite3": "^13.0.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.400.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "tar": "7.5.22",
    "brace-expansion": "2.1.4",
    "@electron/get": {
      "undici": "7.29.0"
    }
  }
}
